# ---- copy to .env and fill in ------------------------------------------------
# MetaTrader 5 (Vantage). Leave LOGIN/PASSWORD empty to attach to the terminal
# that is already logged in.
MT5_ENABLED=true
MT5_TERMINAL_PATH=C:\Program Files\Vantage International MT5\terminal64.exe
# Recommended: leave LOGIN/PASSWORD empty - the bot then attaches to the account that is
# already logged in to the terminal, so no password is stored anywhere.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=VantageInternational-Live
# Vantage symbol suffix if your account uses one (e.g. "+", ".r", ".a"). Check Market Watch.
MT5_SYMBOL_SUFFIX=
# Hours between broker server time and UTC ("auto" detects it from live ticks)
MT5_SERVER_UTC_OFFSET=auto
# auto | ny_close | constant. Vantage = ny_close (UTC+3 in summer, UTC+2 in winter);
# "auto" recognises this from the live offset.
MT5_SERVER_TIME_MODE=auto
# Safety: refuse to run unless the terminal is logged in to a DEMO account
MT5_REQUIRE_DEMO=true
# Optional: broker symbol for the US dollar index (used for gold macro context)
DXY_SYMBOL=

# Telegram (create a bot with @BotFather; get chat id from @userinfobot or getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLE_COMMANDS=true

# Instruments
SYMBOLS=XAUUSD,EURUSD,GBPUSD,USDJPY,GBPJPY,AUDUSD,NZDUSD,USDCAD,USDCHF
# Per-instrument overrides (JSON), e.g. {"XAUUSD": {"broker_symbol": "XAUUSD+", "max_spread_pips": 5}}
INSTRUMENT_OVERRIDES=

# News / fundamentals
# forexfactory | csv | none
CALENDAR_PROVIDER=forexfactory
CALENDAR_CSV_PATH=data/calendar.csv
BLOCK_IF_CALENDAR_UNAVAILABLE=true
NEWS_HIGH_BEFORE_MIN=30
NEWS_HIGH_AFTER_MIN=30
GOLD_TIER1_BEFORE_MIN=45
GOLD_TIER1_AFTER_MIN=60
# optional: headline alerts (finnhub.io, free tier)
FINNHUB_API_KEY=
# optional: US 10Y real/nominal yields for gold (fred.stlouisfed.org)
FRED_API_KEY=

# Signal quality / risk (validate changes with `python main.py walkforward`)
MIN_SIGNAL_SCORE=70
MIN_RR=2.0
TP_R_MULTIPLES=1.0,2.0,3.0
TP_CLOSE_FRACTIONS=0.5,0.3,0.2
MAX_SIGNALS_PER_DAY=6
MAX_CONSECUTIVE_LOSSES=3
ALLOWED_SESSIONS=London,New York
# H4/D1 boundaries when backtests build them from M5 (ny_close matches Vantage MT5)
HTF_ALIGNMENT=ny_close
# Execution-quality gates
# reject if spread > N x median M5 spread of the last day
ABNORMAL_SPREAD_MULT=3.0
WEEK_OPEN_BUFFER_MIN=60
WEEK_CLOSE_BUFFER_MIN=120
# gold: reject when more than this many macro inputs (DXY, yields) contradict the signal
GOLD_MAX_MACRO_CONFLICTS=1
GOLD_ALLOWED_SESSIONS=London,New York
# H4/D1 boundaries when backtests build them from M5 (ny_close matches Vantage MT5)
HTF_ALIGNMENT=ny_close
# Execution-quality gates
# reject if spread > N x median M5 spread of the last day
ABNORMAL_SPREAD_MULT=3.0
WEEK_OPEN_BUFFER_MIN=60
WEEK_CLOSE_BUFFER_MIN=120
# gold: reject when more than this many macro inputs (DXY, yields) contradict the signal
GOLD_MAX_MACRO_CONFLICTS=1

# Runtime
DAILY_REPORT_UTC=21:15
LOG_LEVEL=INFO
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/fxbot   (default: SQLite in data/bot.db)
# mt5 | csv
DATA_PROVIDER=mt5
